# Copy to ".env" and fill in. NEVER commit your real .env.
#   cp .env.example .env

# ── OpenAI — used by all live examples in this course ──
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Default models (override per example if you like) ──
MODEL=gpt-4o                 # main reasoning model
MODEL_FAST=gpt-4o-mini       # routing / cheap classification

# ── Azure OpenAI (optional — Day 9 multi-cloud example) ──
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-01-preview
