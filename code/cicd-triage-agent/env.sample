# RENAME to .env (cp env.sample .env), then fill in. NEVER commit .env.
OPENAI_API_KEY=sk-paste-your-key-here
MODEL=gpt-4o

# The repo whose GitHub Actions the agent triages (owner/name).
GITHUB_REPO=AravindBaranitharan/Agentic-Ai-Devops-

# GitHub auth — EITHER set a token here, OR just run `gh auth login` (the agent
# falls back to the GitHub CLI's token automatically). A fine-grained PAT needs:
#   Actions: Read · Contents: Read · Commit statuses: Write (to post the triage)
# GITHUB_TOKEN=github_pat_xxx
