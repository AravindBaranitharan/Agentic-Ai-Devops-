# RENAME to .env (cp env.sample .env), then paste your key. NEVER commit .env.
OPENAI_API_KEY=sk-paste-your-key-here
MODEL=gpt-4o

# Set true to read a REAL cluster via your kubeconfig (~/.kube/config or KUBECONFIG).
# Left false, the app runs on a realistic MOCK cluster — no cluster needed.
USE_REAL_K8S=false

# Optional: point at a specific kubeconfig for the live path.
# KUBECONFIG=/Users/you/.kube/config
