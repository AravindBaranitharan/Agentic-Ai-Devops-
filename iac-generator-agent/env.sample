# RENAME to .env (cp env.sample .env), then paste your key. NEVER commit .env.
OPENAI_API_KEY=sk-paste-your-key-here
MODEL=gpt-4o

# terraform plan runs for real when the CLI is installed; set false to force mock.
TF_REAL=true

# Needed only for a REAL terraform plan/apply against AWS (or use ~/.aws / a role):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
